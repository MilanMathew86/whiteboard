# Copy to .env for local development (`flask --app chalkback run` reads it), or set these on the host.
# Never commit a real .env.

# development (default), testing or production
CHALKBACK_ENV=development

# Required in production: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL in production (SQLite is refused there). Development defaults to instance/dev.db.
# DATABASE_URL=postgresql://user:password@host:5432/chalkback

# Google OAuth client ("Web application") with these authorised redirect URIs:
#   http://localhost:5000/auth/callback, https://<staging>/auth/callback, https://<production>/auth/callback
# Development defaults to the project's client ID; the secret is always needed for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated; these accounts become admins when they sign in.
ADMIN_EMAILS=

# Rate-limit counters. memory:// is per process; with several gunicorn workers use Redis, e.g.
#   redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=memory://

# 1 when running behind a proxy/load balancer that sets X-Forwarded-* (on by default in production).
# PROXY_FIX=1
